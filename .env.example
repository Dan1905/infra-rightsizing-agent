# --- Model provider ---------------------------------------------------------
# groq (default: free tier, gpt-oss-120b) | anthropic | openai
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...

# Anthropic instead:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Any other OpenAI-compatible endpoint (xAI, Together, OpenRouter, local vLLM):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.x.ai/v1
#   LLM_MODEL=grok-4-fast
#   LLM_API_KEY=...

# Optional overrides -- the defaults match the bundled docker-compose stack.
# LLM_MODEL=openai/gpt-oss-120b
# MAX_TOKENS=4096
# TEMPERATURE=0.2
# MAX_RETRIES=4
# MAX_TURNS=12
# EFFORT=high                  # Anthropic only
#
# PROMETHEUS_URL=http://localhost:9090
# LOOKBACK=1h
# METRICS_STEP=1m
# RAG_TOP_K=3                  # raise if you are not on a tight token budget
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# MANAGED_LABEL=cost-opt.managed
