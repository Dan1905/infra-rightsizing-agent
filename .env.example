# --- Execution backend -------------------------------------------------------
# docker (default: `make up`) | kubernetes (`make k8s-up` + `make port-forward`)
BACKEND=docker
# Kubernetes only:
# K8S_NAMESPACE=cost-opt-sandbox
# KUBE_CONTEXT=cost-opt

# --- Model provider ---------------------------------------------------------
# groq (default: free tier, gpt-oss-120b) | anthropic | openai
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...

# Anthropic instead:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Any other OpenAI-compatible endpoint (xAI, Together, OpenRouter, local vLLM):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.x.ai/v1
#   LLM_MODEL=grok-4-fast
#   LLM_API_KEY=...

# Optional overrides -- the defaults match the bundled sandboxes.
# LLM_MODEL=openai/gpt-oss-120b
# MAX_TOKENS=3072            # default: 3072 on groq, 16000 anthropic, 4096 openai
# REASONING_EFFORT=low       # gpt-oss models only; default low on groq
# TEMPERATURE=0.2
# MAX_RETRIES=4
# MAX_TURNS=12
# EFFORT=high                  # Anthropic only
#
# PROMETHEUS_URL=http://localhost:9090   # 9091 by default when BACKEND=kubernetes
# LOOKBACK=1h
# METRICS_STEP=1m
# RAG_TOP_K=3                  # raise if you are not on a tight token budget
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# MANAGED_LABEL=cost-opt.managed
